---
import Doc from '../../../../layouts/Doc.astro';
import { groups } from '../../../../data/ruleGroups';
import { rulesOfGroup } from '../../../../data/rulesIndex';
import { rulesPageFor } from '../../../../i18n/rulesPage';
import { rulesEs } from '../../../../i18n/rules.es';
import { rulesFr } from '../../../../i18n/rules.fr';
import { rulesIt } from '../../../../i18n/rules.it';
import { rulesJa } from '../../../../i18n/rules.ja';
import { localePaths } from '../../../../i18n/routes';
import type { Locale } from '../../../../data/ruleGroups';

export function getStaticPaths() {
  return localePaths();
}

const { lang } = Astro.props as { lang: Locale };
const copy = rulesPageFor(lang);

const overlays: Record<string, Record<number, Record<string, string>>> = { es: rulesEs, fr: rulesFr, it: rulesIt, ja: rulesJa };

const titleOf = (rule: { id: number; title: Record<string, string> }) =>
  (overlays[lang]?.[rule.id]?.title as string | undefined) ?? rule.title[lang] ?? rule.title.en;

const base = `/${lang}`;
---

<Doc
  title={copy.title}
  kicker={copy.kicker}
  description={copy.lede}
  path="/guide/rules"
  locale={lang}
>
  <p class="lede">{copy.lede}</p>

  <p set:html={copy.intro} />

  {groups.map((group) => (
    <section>
      <h2>{group.pillar} — {group.title[lang]}</h2>
      <ul class="rules-index">
        {rulesOfGroup(group.id).map((rule) => (
          <li>
            <a href={`${base}/guide/rules/${rule.slug}/`}>
              <span class="n">{String(rule.id).padStart(2, '0')}</span>
              <span>{titleOf(rule)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p>{copy.outro}</p>
</Doc>
