---
import Doc from '../layouts/Doc.astro';
import ManifestoBody from '../components/ManifestoBody.astro';
import { manifesto } from '../i18n/manifesto';

const copy = manifesto.en;
---

<Doc
  title="The OTAKU Manifesto"
  kicker={copy.kicker}
  description="Five pillars, forty measurable rules and one primary metric: cyclomatic complexity. The complete OTAKU philosophy."
  path="/manifesto"
>
  <ManifestoBody locale="en" copy={copy} />
</Doc>
