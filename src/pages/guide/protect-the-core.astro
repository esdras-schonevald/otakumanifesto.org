const phpEntity = String.raw`namespace App\Domain\Account;

final class Account
{
    private function __construct(
        private AccountId $id,
        private Money $balance,
    ) {}

    public function withdraw(Money $amount): self
    {
        if ($this->balance->isLessThan($amount)) {
            throw new InsufficientFunds($this->id);
        }

        return new self($this->id, $this->balance->subtract($amount));
    }
}`;

const phpPort = String.raw`namespace App\Domain\Account;

interface Accounts
{
    public function get(AccountId $id): Account;

    public function save(Account ...$accounts): void;
}`;

const phpPorts = String.raw`namespace App\Domain\Account;

interface Accounts
{
    public function get(AccountId $id): Account;
    public function save(Account ...$accounts): void;
}

interface Ledger
{
    public function record(Transfer $transfer): Receipt;
}`;

const csPorts = String.raw`namespace App.Domain.Account;

public interface IAccounts
{
    Account Get(AccountId id);
    void Save(params Account[] accounts);
}

public interface ILedger
{
    Receipt Record(Transfer transfer);
}`;

const javaPorts = String.raw`package app.domain.account;

public interface Accounts {
    Account get(AccountId id);
    void save(Account... accounts);
}

public interface Ledger {
    Receipt record(Transfer transfer);
}`;

const cppPorts = String.raw`namespace app::domain::account {

class Accounts {
public:
    virtual ~Accounts() = default;
    virtual Account get(const AccountId& id) = 0;
    virtual void save(const Account& account) = 0;
};

class Ledger {
public:
    virtual ~Ledger() = default;
    virtual Receipt record(const Transfer& transfer) = 0;
};

}`;

const tsPorts = String.raw`export interface Accounts {
  get(id: AccountId): Account;
  save(...accounts: Account[]): void;
}

export interface Ledger {
  record(transfer: Transfer): Receipt;
}`;

const deptrac = String.raw`# deptrac.yaml
parameters:
  paths:
    - ./src
  layers:
    - name: Domain
      collectors:
        - type: directory
          value: src/Domain/.*
    - name: Application
      collectors:
        - type: directory
          value: src/Application/.*
    - name: Infrastructure
      collectors:
        - type: directory
          value: src/Infrastructure/.*
  ruleset:
    Domain: ~
    Application:
      - Domain
    Infrastructure:
      - Domain
      - Application`;
