const phpIndentBad = String.raw`public function resolve(RoutePath $path): Route
{
    foreach ($this->routes as $route) {
        if ($route->path()->equals($path)) {
            return $route;
        }
    }
    throw new RouteNotFoundException();
}`;

const phpIndentGood = String.raw`public function resolve(RoutePath $path): Route
{
    return $this->find($path) ?? throw new RouteNotFoundException();
}

private function find(RoutePath $path): ?Route
{
    return $this->routes->firstMatching($path);
}`;

const phpElseBad = String.raw`if ($service->isAvailable()) {
    return $this->forward($request, $service);
} else {
    throw new ServiceUnavailableException();
}`;

const phpElseGood = String.raw`if (! $service->isAvailable()) {
    throw new ServiceUnavailableException();
}

return $this->forward($request, $service);`;

const phpEmail = String.raw`final class Email
{
    private function __construct(private string $value) {}

    public static function fromString(string $value): self
    {
        $isValid = filter_var($value, FILTER_VALIDATE_EMAIL) !== false;

        if (! $isValid) {
            throw new InvalidArgumentException('Invalid email address');
        }

        return new self($value);
    }

    public function equals(self $other): bool
    {
        return $this->value === $other->value;
    }
}`;

const csEmail = String.raw`public sealed class Email : IEquatable<Email>
{
    private readonly string value;

    private Email(string value) => this.value = value;

    public static Email FromString(string value)
    {
        if (!value.Contains('@'))
            throw new ArgumentException("Invalid email address", nameof(value));

        return new Email(value);
    }

    public bool Equals(Email? other) =>
        other is not null && other.value == this.value;

    public override bool Equals(object? other) => Equals(other as Email);

    public override int GetHashCode() => value.GetHashCode();
}`;

const javaEmail = String.raw`public final class Email {
    private final String value;

    private Email(String value) {
        this.value = value;
    }

    public static Email fromString(String value) {
        if (!value.contains("@"))
            throw new IllegalArgumentException("Invalid email address");

        return new Email(value);
    }

    @Override
    public boolean equals(Object other) {
        return other instanceof Email email
            && email.value.equals(this.value);
    }

    @Override
    public int hashCode() {
        return value.hashCode();
    }
}`;

const cppEmail = String.raw`class Email final {
public:
    static Email fromString(std::string value) {
        if (value.find('@') == std::string::npos)
            throw std::invalid_argument("invalid email address");

        return Email{std::move(value)};
    }

    bool operator==(const Email&) const = default;

private:
    explicit Email(std::string value) : value_(std::move(value)) {}

    std::string value_;
};`;

const phpCollectionBad = String.raw`/** @var Route[] */
private array $routes;

public function find(string $method, string $path): ?Route
{
    foreach ($this->routes as $route) {
        // filtering logic in the caller
    }
}`;

const phpCollectionGood = String.raw`final class RouteMap
{
    /** @param list<Route> $routes */
    private function __construct(private array $routes) {}

    public static function fromRoutes(Route ...$routes): self
    {
        return new self($routes);
    }

    public function resolve(HttpMethod $method, RoutePath $path): Route
    {
        return $this->matching($method, $path) ?? throw new RouteNotFound($path);
    }

    private function matching(HttpMethod $method, RoutePath $path): ?Route
    {
        foreach ($this->routes as $route) {
            if ($route->matches($method, $path)) {
                return $route;
            }
        }
        return null;
    }
}`;

const csCollection = String.raw`public sealed class RouteMap
{
    private readonly IReadOnlyList<Route> routes;

    private RouteMap(IReadOnlyList<Route> routes) => this.routes = routes;

    public static RouteMap FromRoutes(params Route[] routes) =>
        new(routes);

    public Route Resolve(HttpMethod method, RoutePath path) =>
        Matching(method, path) ?? throw new RouteNotFound(path);

    private Route? Matching(HttpMethod method, RoutePath path) =>
        routes.FirstOrDefault(route => route.Matches(method, path));
}`;

const phpChainBad = String.raw`return $this->registry->find($name)->host()->value();`;

