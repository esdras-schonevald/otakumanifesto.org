const phpAnemic = String.raw`final class Account
{
    public function __construct(
        public readonly string $id,
        public readonly int $balanceInCents,
        public readonly string $currency,
    ) {}
}

$account->balanceInCents -= 500;`;

const phpBehavior = String.raw`final class Account
{
    private function __construct(
        private AccountId $id,
        private Money $balance,
    ) {}

    public function withdraw(Money $amount): self
    {
        return new self($this->id, $this->balance->subtract($amount));
    }
}

$account = $account->withdraw(Money::fromCents(500));`;
