const phpPipe = String.raw`final class TransferMoney
{
    public function __construct(
        private Accounts $accounts,
        private Ledger $ledger,
    ) {}

    public function __invoke(Transfer $transfer): Receipt
    {
        $source = $this->accounts->get($transfer->source());
        $target = $this->accounts->get($transfer->target());

        $debited = $source->debit($transfer->amount());
        $credited = $target->credit($transfer->amount());

        $this->accounts->save($debited, $credited);

        return $this->ledger->record($transfer);
    }
}`;

const csPipe = String.raw`public sealed class TransferMoney
{
    private readonly IAccounts accounts;
    private readonly ILedger ledger;

    public TransferMoney(IAccounts accounts, ILedger ledger)
    {
        this.accounts = accounts;
        this.ledger = ledger;
    }

    public Receipt Execute(Transfer transfer)
    {
        var source = accounts.Get(transfer.Source);
        var target = accounts.Get(transfer.Target);

        var debited = source.Debit(transfer.Amount);
        var credited = target.Credit(transfer.Amount);

        accounts.Save(debited, credited);

        return ledger.Record(transfer);
    }
}`;

const phpRoot = String.raw`// Composition root — infrastructure decides, once.
$transferMoney = new TransferMoney(
    new DoctrineAccounts($entityManager),
    new DoctrineLedger($entityManager),
);

$receipt = $transferMoney(new Transfer($source, $target, $amount));`;

const phpPort = String.raw`namespace App\Domain\Account;

interface Accounts
{
    public function get(AccountId $id): Account;

    public function save(Account ...$accounts): void;
}`;

const phpAdapter = String.raw`namespace App\Infrastructure\Persistence;

final class DoctrineAccounts implements Accounts
{
    public function __construct(private EntityManagerInterface $entityManager) {}

    public function get(AccountId $id): Account
    {
        return $this->entityManager->find(Account::class, $id) ?? throw new AccountNotFound($id);
    }

    public function save(Account ...$accounts): void
    {
        foreach ($accounts as $account) {
            $this->entityManager->persist($account);
        }
        $this->entityManager->flush();
    }
}`;

const phpRepoTest = String.raw`final class InMemoryAccounts implements Accounts
{
    /** @var array<string, Account> */
    private array $accounts = [];

    public function get(AccountId $id): Account
    {
        return $this->accounts[$id->value()] ?? throw new AccountNotFound($id);
    }

    public function save(Account ...$accounts): void
    {
        foreach ($accounts as $account) {
            $this->accounts[$account->id()->value()] = $account;
        }
    }
}`;
