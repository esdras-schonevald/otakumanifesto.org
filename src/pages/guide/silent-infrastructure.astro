const phpPort = String.raw`namespace App\Domain\Account;

interface Accounts
{
    public function get(AccountId $id): Account;

    public function save(Account ...$accounts): void;
}`;

const phpAdapter = String.raw`namespace App\Infrastructure\Persistence;

final class DoctrineAccounts implements Accounts
{
    public function __construct(private EntityManagerInterface $entityManager) {}

    public function get(AccountId $id): Account
    {
        $record = $this->entityManager->find(AccountRecord::class, $id->value());

        return $record === null
            ? throw new AccountNotFound($id)
            : $record->toDomain();
    }

    public function save(Account ...$accounts): void
    {
        foreach ($accounts as $account) {
            $this->entityManager->persist(AccountRecord::fromDomain($account));
        }

        $this->entityManager->flush();
    }
}`;

const cppPort = String.raw`namespace app::domain {

class Accounts {
public:
    virtual ~Accounts() = default;
    virtual Account get(const AccountId& id) const = 0;
    virtual void save(const Account& account) = 0;
};

}`;

const javaValue = String.raw`package app.domain.account;

public record Money(long cents, String currency) {
    public Money {
        if (cents < 0) throw new IllegalArgumentException("negative");
        Objects.requireNonNull(currency);
    }
}`;

const tsValue = String.raw`export class Email {
  private constructor(private readonly value: string) {}

  static fromString(value: string): Email {
    if (!value.includes('@')) {
      throw new Error('Invalid email address');
    }

    return new Email(value);
  }

  equals(other: Email): boolean {
    return other.value === this.value;
  }
}`;

const csPoco = String.raw`namespace App.Domain.Account;

public sealed class Account
{
    public AccountId Id { get; }
    public Money Balance { get; private set; }

    private Account(AccountId id, Money balance)
    {
        Id = id;
        Balance = balance;
    }

    public static Account Open(AccountId id, Money initial) =>
        new(id, initial);

    public void Withdraw(Money amount) =>
        Balance = Balance.Subtract(amount);
}`;
