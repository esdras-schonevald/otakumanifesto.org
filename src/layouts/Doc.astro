---
import '../styles/main.css';
import SideNav from '../components/SideNav.astro';
import { neighbour, translatedPaths, flat } from '../data/nav';
import { ui, localePath, localeNames, htmlLang, activeLocales, locales } from '../i18n/ui';
import type { Locale } from '../data/ruleGroups';

interface Props {
  title: string;
  kicker: string;
  description: string;
  path: string;
  locale?: Locale;
  bare?: boolean;
  translated?: boolean;
  pager?: boolean;
}

const { title, kicker, description, path, locale = 'en', bare = false, translated, pager = true } = Astro.props;
const strings = ui[locale];

const canonical = new URL(localePath(locale, path), Astro.site);
const fullTitle = path === '/' ? title : `${title} — OTAKU Manifesto`;

const translatedHere = translated ?? translatedPaths.has(path);
const { previous, next } = neighbour(path);
const current = flat.find((item) => item.path === path);

const hrefFor = (target: string): string =>
  translatedPaths.has(target) ? localePath(locale, target) : target;

const offered = translatedHere ? activeLocales : (['en'] as Locale[]);
const alternates = offered.map((code) => ({ code, href: localePath(code, path) }));
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e11" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="OTAKU Manifesto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={htmlLang[alternate.code]} href={new URL(alternate.href, Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <div class="shell">
      <aside class="side">
        <a class="brand" href={localePath(locale, '/')}>
          <span class="brand__mark" aria-hidden="true">OTK</span>
          <span>otakumanifesto.org</span>
        </a>

        <div class="side__desktop">
          <SideNav path={path} locale={locale} />
        </div>

        <details class="side__mobile">
          <summary>{strings.contents}</summary>
          <SideNav path={path} locale={locale} />
        </details>

        <details class="lang">
          <summary>{strings.language} · {localeNames[locale]}</summary>
          <ul>
            {activeLocales.map((code) => (
              <li>
                <a
                  href={translatedHere ? localePath(code, path) : localePath(code, '/')}
                  hreflang={htmlLang[code]}
                  lang={htmlLang[code]}
                  aria-current={code === locale ? 'true' : undefined}
                >{localeNames[code]}</a>
              </li>
            ))}
          </ul>
        </details>
      </aside>

      <main class="main">
        <p class="crumb">
          <a href={localePath(locale, '/')}>OTAKU</a> / {current ? strings[current.key] : title}
        </p>

        {!bare && (
          <>
            <div class="kicker">{kicker}</div>
            <h1>{title}</h1>
          </>
        )}

        <article class="prose">
          {!translatedHere && locale !== 'en' && (
            <p class="note note--warn">{strings.englishOnly}</p>
          )}
          <slot />
        </article>

        {pager && (
        <nav class="pager" aria-label="Chapter navigation">
          {previous ? (
            <a href={hrefFor(previous.path)}>
              <span>{strings.previous}</span>
              {strings[previous.key]}
            </a>
          ) : <span />}
          {next ? (
            <a class="next" href={hrefFor(next.path)}>
              <span>{strings.next}</span>
              {strings[next.key]}
            </a>
          ) : null}
        </nav>
        )}

        <footer class="foot">
          <span>OTAKU Manifesto · <a href={localePath(locale, '/about')}>{strings.license}</a></span>
          <span>
            <a href="https://phprise.org">PHPRise</a> ·
            <a href="https://github.com/esdras-schonevald/otakumanifesto.org">{strings.source}</a> ·
            <a href="https://github.com/esdras-schonevald">esdras-schonevald</a>
          </span>
        </footer>
      </main>
    </div>
  </body>
</html>
