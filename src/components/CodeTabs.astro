---
import { Code } from 'astro:components';
import type { Lang } from '../data/ruleContent';

interface Tab {
  label: string;
  lang: Lang;
  code: string;
}

interface Props {
  tabs: Tab[];
  title?: string;
}

const { tabs, title } = Astro.props;
const group = `tabs-${Math.random().toString(36).slice(2, 9)}`;
const keys = tabs.map((_, index) => `${group}-${index}`);

const css = keys
  .map(
    (key) =>
      `.tabs:has(#${key}:checked) [data-panel="${key}"]{display:block}` +
      `.tabs:has(#${key}:checked) label[for="${key}"]{color:var(--accent);border-color:var(--accent);background:var(--panel)}`,
  )
  .join('');
---

<div class="tabs">
  {tabs.map((tab, index) => (
    <input
      type="radio"
      name={group}
      id={keys[index]}
      checked={index === 0}
      aria-label={`${title ?? 'Code'}: ${tab.label}`}
    />
  ))}

  <div class="tabs__bar" role="tablist" aria-label={title ?? 'Code examples'}>
    {tabs.map((tab, index) => (
      <label for={keys[index]}>{tab.label}</label>
    ))}
  </div>

  <div class="tabs__panels">
    {tabs.map((tab, index) => (
      <div class="tabs__panel" data-panel={keys[index]}>
        <Code
          code={tab.code}
          lang={tab.lang}
          themes={{ light: 'github-light', dark: 'github-dark' }}
        />
      </div>
    ))}
  </div>
</div>

<style is:inline set:html={css}></style>
