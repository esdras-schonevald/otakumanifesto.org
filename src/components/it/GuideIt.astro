      <tr><td><a href="/it/guide/protect-the-core/">Protezione</a></td><td>A</td><td>Direzione delle dipendenze, porte e adattatori, test di architettura.</td></tr>
      <tr><td><a href="/it/guide/silent-infrastructure/">Silenzio</a></td><td>K</td><td>Repository, oggetti semplici e il database come dettaglio.</td></tr>
      <tr><td><a href="/it/guide/contracts/">Contratti</a></td><td>U</td><td>Linguaggio ubiquo, design-first e cosa promette davvero un contratto.</td></tr>
      <tr><td><a href="/it/guide/checklist/">Audit</a></td><td>—</td><td>Una checklist di revisione da eseguire su un repository reale in un’ora.</td></tr>
    </tbody>
