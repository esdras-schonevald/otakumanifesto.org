---
import { groups } from '../data/ruleGroups';
import { rules } from '../data/rules';
import type { Locale } from '../data/ruleGroups';

interface Props {
  locale: Locale;
  copy: any;
}

const { locale, copy } = Astro.props;

const pillarName = (letter: string) => copy.pillars.find((p: any) => p.letter === letter);
---

<p class="lede">{copy.lede}</p>

{copy.intro.map((paragraph: string) => <p>{paragraph}</p>)}

<div class="pillars">
  {copy.pillars.map((pillar: any) => (
    <div class="pillar">
      <div class="pillar__letter">{pillar.letter}</div>
      <div>
        <h3 class="pillar__name">{pillar.name}</h3>
        <p class="pillar__short">{pillar.short}</p>
        <p class="pillar__body">{pillar.body}</p>
      </div>
    </div>
  ))}
</div>

<h2>{copy.metricH}</h2>
<p>{copy.metricP1}</p>
<p>{copy.metricP2}</p>

<h2>{copy.rulesH}</h2>
<p>{copy.rulesIntro}</p>

<p class="small mono">{copy.totalLine}</p>

{groups.map((group) => (
  <section class="rule-group">
    <h3 class="rule-group__title">
      <span class="rule-group__pillar">{group.pillar}</span>
      {group.title[locale]}
    </h3>
    <ol class="rules" start={group.ids[0]}>
      {group.ids.map((id) => (
        <li value={id}>{rules.find((rule) => rule.id === id)?.text[locale]}</li>
      ))}
    </ol>
  </section>
))}

<h2>{copy.closingH}</h2>
<p>{copy.closingP1}</p>
<p>{copy.closingP2}</p>
